    "@types/node": "^20.11.24",
    "chai": "^4.3.7",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "hardhat": "^2.22.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
